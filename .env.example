# Copy to .env for local development:  cp .env.example .env
# On Vercel set these under Project -> Settings -> Environment Variables.
# Never commit the real .env file (it is git-ignored).

# Upstash Redis REST credentials. Connecting Upstash from the Vercel Storage tab sets
# KV_REST_API_URL / KV_REST_API_TOKEN for you; either pair of names works.
# Leave both empty locally to use the built-in in-memory mock (data is lost on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: extra origins allowed to call /api/glint, comma separated. The site's own origin is always allowed.
# Example: https://glint.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# Optional: port for `npm run dev`
PORT=3000
